{
  "frameworks": [
    {
      "id": "cis-netscaler",
      "name": "CIS Citrix NetScaler Benchmark",
      "controls": [
        {
          "id": "CIS-1.1",
          "title": "Enforce strong password policy",
          "severity": "critical",
          "check": {
            "type": "nitro",
            "endpoint": "systemparameter",
            "field": "strongpassword",
            "expected": "enableall"
          }
        },
        {
          "id": "CIS-1.2",
          "title": "Minimum password length >= 8",
          "severity": "critical",
          "check": {
            "type": "nitro",
            "endpoint": "systemparameter",
            "field": "minpasswordlen",
            "expected": "8",
            "operator": "gte"
          }
        },
        {
          "id": "CIS-1.3",
          "title": "Session timeout configured (<= 900s)",
          "severity": "high",
          "check": {
            "type": "nitro",
            "endpoint": "systemparameter",
            "field": "timeout",
            "expected": "900",
            "operator": "lte"
          }
        },
        {
          "id": "CIS-1.4",
          "title": "Disable HTTP basic authentication",
          "severity": "high",
          "check": {
            "type": "nitro",
            "endpoint": "systemparameter",
            "field": "basicauth",
            "expected": "DISABLED"
          }
        },
        {
          "id": "CIS-1.5",
          "title": "Limit maximum concurrent admin sessions",
          "severity": "medium",
          "check": {
            "type": "nitro",
            "endpoint": "systemparameter",
            "field": "maxclient",
            "expected": "40",
            "operator": "lte"
          }
        },
        {
          "id": "CIS-2.1",
          "title": "Enable TLS 1.2 cipher suites",
          "severity": "critical",
          "check": {
            "type": "nitro_binding",
            "endpoint": "sslvserver_sslciphersuite_binding/lb_vsrv_https",
            "field": "ciphername",
            "expected": "TLS1.2-ECDHE-RSA-AES256-GCM-SHA384"
          }
        },
        {
          "id": "CIS-2.2",
          "title": "Enable TLS 1.3 cipher suites",
          "severity": "critical",
          "check": {
            "type": "nitro_binding",
            "endpoint": "sslvserver_sslciphersuite_binding/lb_vsrv_https",
            "field": "ciphername",
            "expected": "TLS1.3-AES256-GCM-SHA384"
          }
        },
        {
          "id": "CIS-3.1",
          "title": "HTTP profile drops invalid requests",
          "severity": "high",
          "check": {
            "type": "nitro",
            "endpoint": "nshttpprofile/nshttp_hardened",
            "field": "dropinvalreqs",
            "expected": "ENABLED"
          }
        },
        {
          "id": "CIS-3.2",
          "title": "HTTP profile marks HTTP/0.9 invalid",
          "severity": "medium",
          "check": {
            "type": "nitro",
            "endpoint": "nshttpprofile/nshttp_hardened",
            "field": "markhttp09inval",
            "expected": "ENABLED"
          }
        },
        {
          "id": "CIS-3.3",
          "title": "HTTP profile marks CONNECT invalid",
          "severity": "medium",
          "check": {
            "type": "nitro",
            "endpoint": "nshttpprofile/nshttp_hardened",
            "field": "markconnreqinval",
            "expected": "ENABLED"
          }
        },
        {
          "id": "CIS-3.4",
          "title": "HTTP profile marks TRACE invalid",
          "severity": "high",
          "check": {
            "type": "nitro",
            "endpoint": "nshttpprofile/nshttp_hardened",
            "field": "marktracereqinval",
            "expected": "ENABLED"
          }
        },
        {
          "id": "CIS-4.1",
          "title": "TCP SYN flood protection enabled",
          "severity": "critical",
          "check": {
            "type": "nitro",
            "endpoint": "nstcpprofile/nstcp_hardened",
            "field": "spoofsyndrop",
            "expected": "ENABLED"
          }
        },
        {
          "id": "CIS-4.2",
          "title": "TCP RST window attenuation enabled",
          "severity": "high",
          "check": {
            "type": "nitro",
            "endpoint": "nstcpprofile/nstcp_hardened",
            "field": "rstwindowattenuate",
            "expected": "ENABLED"
          }
        },
        {
          "id": "CIS-5.1",
          "title": "Remove Server header from responses",
          "severity": "medium",
          "check": {
            "type": "http_header",
            "header": "Server",
            "expect": "absent"
          }
        },
        {
          "id": "CIS-5.2",
          "title": "Remove X-Powered-By header from responses",
          "severity": "medium",
          "check": {
            "type": "http_header",
            "header": "X-Powered-By",
            "expect": "absent"
          }
        }
      ]
    },
    {
      "id": "pci-dss-v4",
      "name": "PCI-DSS v4.0",
      "controls": [
        {
          "id": "PCI-2.2.1",
          "title": "System configuration standards applied",
          "severity": "high",
          "check": {
            "type": "nitro_exists",
            "endpoint": "nshttpprofile/nshttp_hardened"
          }
        },
        {
          "id": "PCI-2.2.2",
          "title": "Unnecessary services disabled",
          "severity": "high",
          "check": {
            "type": "nitro",
            "endpoint": "systemparameter",
            "field": "basicauth",
            "expected": "DISABLED"
          }
        },
        {
          "id": "PCI-4.2.1",
          "title": "Strong cryptography for data transmission",
          "severity": "critical",
          "check": {
            "type": "nitro_binding",
            "endpoint": "sslvserver_sslciphersuite_binding/lb_vsrv_https",
            "field": "ciphername",
            "expected": "TLS1.2-ECDHE-RSA-AES256-GCM-SHA384"
          }
        },
        {
          "id": "PCI-4.2.1.1",
          "title": "Only trusted TLS cipher suites configured",
          "severity": "critical",
          "check": {
            "type": "nitro_binding",
            "endpoint": "sslvserver_sslciphersuite_binding/lb_vsrv_https",
            "field": "ciphername",
            "expected": "TLS1.3-AES256-GCM-SHA384"
          }
        },
        {
          "id": "PCI-4.2.1.2",
          "title": "HSTS enforced with minimum 1-year max-age",
          "severity": "critical",
          "check": {
            "type": "http_header",
            "header": "Strict-Transport-Security",
            "contains": "max-age=31536000"
          }
        },
        {
          "id": "PCI-4.2.1.3",
          "title": "HTTP redirected to HTTPS",
          "severity": "critical",
          "check": {
            "type": "nitro_exists",
            "endpoint": "responderpolicy/pol_redirect_https"
          }
        },
        {
          "id": "PCI-6.4.1",
          "title": "Web attack protection (bot blocking)",
          "severity": "high",
          "check": {
            "type": "nitro_exists",
            "endpoint": "responderpolicy/pol_block_bot"
          }
        },
        {
          "id": "PCI-6.4.2",
          "title": "Content-Security-Policy header configured",
          "severity": "high",
          "check": {
            "type": "http_header",
            "header": "Content-Security-Policy",
            "expect": "present"
          }
        },
        {
          "id": "PCI-6.5.4",
          "title": "Clickjacking protection (X-Frame-Options)",
          "severity": "high",
          "check": {
            "type": "http_header",
            "header": "X-Frame-Options",
            "contains": "DENY"
          }
        },
        {
          "id": "PCI-6.5.7",
          "title": "XSS protection header configured",
          "severity": "high",
          "check": {
            "type": "http_header",
            "header": "X-XSS-Protection",
            "expect": "present"
          }
        },
        {
          "id": "PCI-8.3.6",
          "title": "Password complexity requirements enforced",
          "severity": "critical",
          "check": {
            "type": "nitro",
            "endpoint": "systemparameter",
            "field": "strongpassword",
            "expected": "enableall"
          }
        },
        {
          "id": "PCI-10.2.1",
          "title": "Audit logging enabled",
          "severity": "high",
          "check": {
            "type": "nitro_exists",
            "endpoint": "auditmessageaction/act_log_http"
          }
        }
      ]
    },
    {
      "id": "nist-800-53",
      "name": "NIST 800-53 Rev 5",
      "controls": [
        {
          "id": "SC-8",
          "title": "Transmission confidentiality and integrity",
          "severity": "critical",
          "check": {
            "type": "tls",
            "field": "protocol",
            "expected": "TLSv1.2"
          }
        },
        {
          "id": "SC-13",
          "title": "Cryptographic protection (AEAD ciphers)",
          "severity": "critical",
          "check": {
            "type": "nitro_binding",
            "endpoint": "sslvserver_sslciphersuite_binding/lb_vsrv_https",
            "field": "ciphername",
            "expected": "TLS1.2-ECDHE-RSA-AES128-GCM-SHA256"
          }
        },
        {
          "id": "SC-23",
          "title": "Session authenticity (HSTS)",
          "severity": "high",
          "check": {
            "type": "http_header",
            "header": "Strict-Transport-Security",
            "expect": "present"
          }
        },
        {
          "id": "SI-10",
          "title": "Information input validation",
          "severity": "high",
          "check": {
            "type": "nitro",
            "endpoint": "nshttpprofile/nshttp_hardened",
            "field": "dropinvalreqs",
            "expected": "ENABLED"
          }
        },
        {
          "id": "AC-3",
          "title": "Access enforcement (session limits)",
          "severity": "high",
          "check": {
            "type": "nitro",
            "endpoint": "systemparameter",
            "field": "maxclient",
            "expected": "40",
            "operator": "lte"
          }
        },
        {
          "id": "AC-7",
          "title": "Session timeout for idle sessions",
          "severity": "high",
          "check": {
            "type": "nitro",
            "endpoint": "systemparameter",
            "field": "restrictedtimeout",
            "expected": "ENABLED"
          }
        },
        {
          "id": "AC-17",
          "title": "Remote access protection (TLS required)",
          "severity": "critical",
          "check": {
            "type": "nitro_exists",
            "endpoint": "responderpolicy/pol_redirect_https"
          }
        },
        {
          "id": "AU-2",
          "title": "Audit events configured (HTTP logging)",
          "severity": "high",
          "check": {
            "type": "nitro_exists",
            "endpoint": "rewritepolicy/pol_log_http"
          }
        },
        {
          "id": "CM-7",
          "title": "Least functionality (unnecessary features disabled)",
          "severity": "medium",
          "check": {
            "type": "nitro",
            "endpoint": "nsfeature",
            "field": "lb",
            "expected": "True"
          }
        },
        {
          "id": "SC-28",
          "title": "Protection of information at rest (cert chain validated)",
          "severity": "high",
          "check": {
            "type": "nitro",
            "endpoint": "sslcertkey/wildcard",
            "field": "linkcertkeyname",
            "expected": "lab-ca"
          }
        }
      ]
    }
  ]
}
